# Public application configuration (safe placeholders only)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Never place service-role or production credentials in VITE_* variables.

# Server-only Edge Function secret. Generate a long random value for local use and
# provide it through the function environment; never expose or commit the real value.
ACTION_TOKEN_PEPPER=replace-with-a-long-random-local-secret
