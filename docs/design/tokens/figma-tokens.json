{
  "$description": "PLACEHOLDER. Replace this file with the real export of Figma Variables (W3C Design Tokens / DTCG JSON) once it is provided. These values currently just mirror the hand-authored tokens that predate this pipeline, so pnpm design:tokens is provably a no-op until the real export lands.",
  "color": {
    "canvas": { "$type": "color", "$value": "#f6f4ee" },
    "surface": { "$type": "color", "$value": "#fffdf8" },
    "ink": { "$type": "color", "$value": "#161714" },
    "muted": { "$type": "color", "$value": "#5e6259" },
    "border": { "$type": "color", "$value": "#dedbd1" },
    "border-strong": { "$type": "color", "$value": "#aaa99f" },
    "accent": { "$type": "color", "$value": "#b43d22" },
    "focus": { "$type": "color", "$value": "#3156ce" }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "Inter",
        "ui-sans-serif",
        "system-ui",
        "-apple-system",
        "BlinkMacSystemFont",
        "Segoe UI",
        "sans-serif"
      ]
    },
    "size": {
      "xs": { "$type": "dimension", "$value": "0.75rem" },
      "sm": { "$type": "dimension", "$value": "0.9rem" },
      "lg": { "$type": "dimension", "$value": "1.35rem" }
    }
  },
  "space": {
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "6": { "$type": "dimension", "$value": "1.5rem" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "0.35rem" }
  }
}
